{
    "interface_version": 2,
    "name": "MaaShiningNikki",
    "description": "闪耀暖暖小助手",
    "contact": "",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate/",
    "version": "0.0.1",
    "title": "小灰毛",
    "icon": "logo.ico",
    "agent": {
        "child_exec": "python",
        "child_args": [
        "-u",
        "./../agent/main.py"
        ]
    },
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "好友",
            "entry": "好友任务链入口"
        },
        {
            "name": "联盟",
            "entry": "联盟任务链入口"
        },
        {
            "name": "邮件",
            "entry": "邮件任务链入口"
        },
        {
            "name": "福利",
            "entry": "福利任务链入口"
        },
        {
            "name": "回家",
            "entry": "回家任务链入口"
        },
        {
            "name": "设计中心",
            "entry": "设计中心任务链入口",
            "option": [
                "设计中心任务选择"
            ]
        },
        {
            "name": "结伴",
            "entry": "体力任务链入口"
        },
        {
            "name": "竞技场",
            "entry": "竞技场任务链入口",
            "option": [
                "竞技场刷新次数",
                "竞技场是否搭配服装"
            ]
        },
        {
            "name": "搭配评选赛",
            "entry": "搭配评选赛任务链入口"
        },
        {
            "name": "一键领取",
            "entry": "一键领取任务链入口"
        },
        {
            "name": "织吻为拥",
            "entry": "活动任务链入口"
        }
    ],
    "option": {
        "设计中心任务选择": {
            "type": "checkbox",
            "label": "设计中心任务",
            "description": "选择本次进入设计中心后要运行的子任务。情报屋目前仅保留入口占位。",
            "default_case": [
                "美甲",
                "制作目标服装"
            ],
            "cases": [
                {
                    "name": "美甲",
                    "pipeline_override": {
                        "设计中心运行美甲": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "制作目标服装",
                    "pipeline_override": {
                        "设计中心运行制作目标服装": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "情报屋",
                    "description": "暂未编写具体流程，当前选中后会直接结束设计中心任务。",
                    "pipeline_override": {
                        "设计中心运行情报屋": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "竞技场刷新次数": {
            "type": "input",
            "label": "竞技场刷新设置",
            "description": "调整竞技场战力刷新的最大轮数。对比从左到右进行，玩家战力大于对方则自动挑战",
            "inputs": [
                {
                    "name": "max_rounds",
                    "label": "最大刷新轮数",
                    "description": "查找弱对手的最大轮数，每轮对比3个对手",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$|^1[0-9]$|^20$",
                    "pattern_msg": "请输入1-20之间的整数"
                }
            ],
            "pipeline_override": {
                "竞技场战力对比": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "area_a": [0, 0, 200, 60],
                                "area_b": [
                                    [0, 200, 200, 60],
                                    [0, 400, 200, 60],
                                    [0, 600, 200, 60]
                                ],
                                "refresh": [500, 1100, 200, 60],
                                "max_rounds": "{{max_rounds}}"
                            }
                        }
                    }
                }
            }
        },
        "竞技场是否搭配服装":{
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "点击钻石竞技场":{
                            "next": ["竞技场战力对比", "[JumpBack]在加载页面", "[JumpBack]点击OK-竞技场"]
                        }
                    }
                }
            ]
        }
    }
}
