    "option": {
        "联盟商店": {
            "type": "select",
            "default_case": "三张幻之券",
            "cases": [
                {
                    "name": "三张幻之券",
                    "pipeline_override": {}
                },
                {
                    "name": "三张幻之券+三张绮之券",
                    "pipeline_override": {
                        "点击联盟商店": {
                            "next": ["[JumpBack]在加载页面","点击绮之券"]
                        }
                    }
                }
            ]
        },
        "时光钟表铺模式": {
            "type": "select",
            "label": "时光钟表铺模式",
            "description": "选择本次时光钟表铺任务的执行方式。",
            "default_case": "快速组队（关卡04）",
            "cases": [
                {
                    "name": "快速组队（关卡04）",
                    "pipeline_override": {}
                },
                {
                    "name": "独自登场_循环",
                    "option": [
                        "时光钟表铺独自登场次数"
                    ],
                    "pipeline_override": {
                        "时光钟表铺任务链入口": {
                            "next": ["重置时光钟表铺独自登场次数", "[JumpBack]返回主页面"]
                        },
                        "点击时光钟表铺": {
                            "next": ["点击01"]
                        },
                        "点击01": {
                            "next": ["点击独自登场"]
                        }
                    }
                }
            ]
        },
        "时光钟表铺独自登场次数": {
            "type": "input",
            "label": "独自登场次数",
            "description": "只能在独自登场必定失败时使用。0表示默认执行3次；1-3表示总执行次数。独自登场后将等待失败结算，单场等待超过180秒时结束任务且不计入次数。",
            "inputs": [
                {
                    "name": "solo_runs",
                    "label": "独自登场次数",
                    "description": "请输入0-3之间的整数。0表示总共执行3次；1-3表示对应的总执行次数。单场等待失败结算超过180秒时结束任务且不计入次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-3]$",
                    "pattern_msg": "请输入0-3之间的整数"
                }
            ],
            "pipeline_override": {
                "检查时光钟表铺独自登场次数": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "time_clock_shop_counter",
                            "custom_action_param": {
                                "operation": "count",
                                "max_runs": "{solo_runs}"
                            }
                        }
                    }
                }
            }
        },
        "不落的帷幕模式": {
            "type": "select",
            "label": "不落的帷幕模式",
            "description": "选择本次不落的帷幕任务的执行方式。",
            "default_case": "快速组队（高难度·第八幕）",
            "cases": [
                {
                    "name": "快速组队（高难度·第八幕）",
                    "pipeline_override": {}
                },
                {
                    "name": "独自登场_循环（普通难度·第一幕）",
                    "option": [
                        "不落的帷幕独自登场次数"
                    ],
                    "pipeline_override": {
                        "不落的帷幕任务链入口": {
                            "next": ["重置不落的帷幕独自登场次数", "[JumpBack]返回主页面"]
                        },
                        "点击上演中": {
                            "next": ["点击普通难度"]
                        },
                        "点击第一幕": {
                            "next": ["点击不落的帷幕-独自登场"]
                        }
                    }
                }
            ]
        },
        "不落的帷幕独自登场次数": {
            "type": "input",
            "label": "独自登场次数",
            "description": "只能在独自登场必定失败时使用。0表示默认执行3次；1-3表示总执行次数。若未识别到失败结算页，将立即结束且不再循环。",
            "inputs": [
                {
                    "name": "solo_runs",
                    "label": "独自登场次数",
                    "description": "请输入0-3之间的整数。0表示总共执行3次；1-3表示对应的总执行次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-3]$",
                    "pattern_msg": "请输入0-3之间的整数"
                }
            ],
            "pipeline_override": {
                "检查不落的帷幕独自登场次数": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "unending_curtain_counter",
                            "custom_action_param": {
                                "operation": "count",
                                "max_runs": "{solo_runs}"
                            }
                        }
                    }
                }
            }
        },
        "分享次数": {
            "type": "input",
            "label": "最多分享次数",
            "description": "输入0时重复分享直到分享奖励领完；输入1-5时最多分享指定次数，若提前没有奖励则提前停止。",
            "inputs": [
                {
                    "name": "max_shares",
                    "label": "分享次数",
                    "description": "请输入0-5之间的整数。0表示沿用原逻辑，1-5表示本次任务的最多分享次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-5]$",
                    "pattern_msg": "请输入0-5之间的整数"
                }
            ],
            "pipeline_override": {
                "检查分享次数": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "share_counter",
                            "custom_action_param": {
                                "operation": "count",
                                "max_shares": "{max_shares}"
                            }
                        }
                    }
                }
            }
        },
        "制作目标服装材料任务": {
            "type": "checkbox",
            "label": "制作目标服装材料任务",
            "description": "选择需要执行的材料来源。无论勾选顺序如何，都会按时空回廊、心灵迷宫、主线的顺序执行。",
            "default_case": ["时空回廊获取材料"],
            "cases": [
                {
                    "name": "时空回廊获取材料",
                    "pipeline_override": {
                        "制作目标服装选择时空回廊": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "心灵迷宫获取材料",
                    "option": [
                        "制作目标服装心灵迷宫挑战次数"
                    ],
                    "pipeline_override": {
                        "制作目标服装选择心灵迷宫": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "主线获取材料",
                    "option": [
                        "制作目标服装主线挑战次数"
                    ],
                    "pipeline_override": {
                        "制作目标服装选择主线": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "制作目标服装心灵迷宫挑战次数": {
            "type": "input",
            "label": "心灵迷宫最大挑战次数",
            "description": "只点击“挑战多次”。挑战次数按整个心灵迷宫材料阶段累计，实际次数不会超过设置值。",
            "inputs": [
                {
                    "name": "max_challenges",
                    "label": "最大挑战次数",
                    "description": "输入0表示不设置挑战次数上限；输入正整数表示整个心灵迷宫阶段的挑战次数硬上限。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]?|100)$",
                    "pattern_msg": "请输入0-100之间的整数"
                }
            ],
            "pipeline_override": {
                "批量挑战心灵迷宫制衣材料": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "make_target_clothes_batch_challenge",
                            "custom_action_param": {
                                "mode": "heart_maze",
                                "sufficient_roi": [379, 355, 265, 63],
                                "sufficient_expected": ["数量已足够"],
                                "stamina_roi": [82, 0, 145, 40],
                                "stamina_cost_roi": [55, 755, 205, 52],
                                "remaining_count_roi": [298, 755, 330, 52],
                                "multi_button": [210, 806, 135, 67],
                                "popup_close_roi": [221, 137, 137, 78],
                                "max_challenges": "{max_challenges}",
                                "limit_next": ["返回制衣页面-心灵迷宫达到上限"],
                                "insufficient_stamina_next": ["返回制衣页面-心灵迷宫体力不足"],
                                "max_multi": 10,
                                "retry": 3,
                                "retry_delay": 1.5,
                                "max_rounds": 100
                            }
                        }
                    }
                }
            }
        },
        "制作目标服装主线挑战次数": {
            "type": "input",
            "label": "主线最大挑战次数",
            "description": "只点击“挑战多次”。实际次数不会超过设置值，但在无法安全凑足时可能少于设置值。",
            "inputs": [
                {
                    "name": "max_challenges",
                    "label": "最大挑战次数",
                    "description": "输入0表示尽量耗尽剩余体力；输入正整数表示实际挑战次数的硬上限。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9][0-9]{0,2})$",
                    "pattern_msg": "请输入0-999之间的整数"
                }
            ],
            "pipeline_override": {
                "批量挑战主线制衣材料": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "make_target_clothes_batch_challenge",
                            "custom_action_param": {
                                "mode": "main_story",
                                "sufficient_roi": [379, 355, 265, 63],
                                "sufficient_expected": ["数量已足够"],
                                "stamina_roi": [82, 0, 145, 40],
                                "stamina_cost_roi": [55, 755, 205, 52],
                                "multi_button": [210, 806, 135, 67],
                                "popup_close_roi": [221, 137, 137, 78],
                                "max_challenges": "{max_challenges}",
                                "limit_next": ["返回制衣页面-主线达到上限"],
                                "insufficient_stamina_next": ["返回制衣页面-主线达到上限"],
                                "max_multi": 10,
                                "retry": 3,
                                "retry_delay": 1.5,
                                "max_rounds": 100
