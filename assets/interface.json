        "主线挑战关卡尾号": {
            "type": "input",
            "label": "关卡序号",
            "description": "只填写连字符后的数字。例如选择第二章并填写3，程序会查找2-3。",
            "inputs": [
                {
                    "name": "stage_suffix",
                    "label": "关卡尾号",
                    "description": "请输入1-99之间的整数，不要填写章节前缀和连字符。",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|[1-9][0-9])$",
                    "pattern_msg": "请输入1-99之间的整数"
                }
            ],
            "pipeline_override": {
                "主线查找第一章关卡": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "main_storyline_find_stage",
