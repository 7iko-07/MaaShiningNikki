        "回忆小铺设置": {
            "type": "input",
            "label": "回忆小铺设置",
            "description": "配置回忆小铺金币商品购买、钻石商品暂停折扣，以及非免费刷新时是否继续。",
            "inputs": [
                {
                    "name": "auto_buy_gold",
                    "label": "自动购买金币商品",
                    "description": "开启后发现金币商品会自动点击购买并确认；关闭时发现金币商品会暂停。",
                    "default": "false",
                    "pipeline_type": "bool",
                    "verify": "^(true|false)$",
                    "pattern_msg": "请输入 true 或 false"
                },
                {
                    "name": "diamond_discount_threshold",
                    "label": "钻石暂停折扣",
                    "description": "请输入1-9之间的整数，例如4表示4折及以下暂停。\n\n出现低于此折扣的钻石商品时不再刷新。\n\n输入1时不因折扣暂停。",
                    "default": "4",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9之间的整数"
                },
                {
                    "name": "diamond_price_threshold",
                    "label": "钻石暂停价格",
                    "description": "不包括排除商品。存在实际价格低于该值的钻石商品时暂停，优先级高于折扣判断。\n\n输入0表示不按价格暂停。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入非负整数"
                },
                {
                    "name": "continue_refresh_when_not_free",
                    "label": "非免费继续刷新",
                    "description": "开启后“换一批”不是免费刷新时仍继续点击；关闭时会暂停。",
                    "default": "false",
                    "pipeline_type": "bool",
                    "verify": "^(true|false)$",
                    "pattern_msg": "请输入 true 或 false"
                }
            ],
            "pipeline_override": {
