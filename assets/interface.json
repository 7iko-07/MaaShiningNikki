            "description": "搭配评选赛点赞",
            "group": ["日常任务"]
        },
        {
            "name": "感应谜之海两次",
            "entry": "心之门任务链入口",
            "option": [
                "是否在心之门这里分享"
            ],
            "description": "###[color:red][b]如果误点击消耗资源概不负责，加了重重防护应该不会出现误点击消耗资源的情况。[/b][/color]",
            "group": ["日常任务"]
        },
        {
            "name": "月卡领取",
            "entry": "月卡任务链入口",
            "group": ["日常任务"]
        },
        {
            "name": "特权卡领取",
            "entry": "特权卡任务链入口",
            "group": ["日常任务"]
        },
        {
            "name": "活动：一叶灼春",
            "entry": "活动任务链入口",
            "default_check": false,
            "description": "###[color:red][b]活动剧情默认关闭，使用时不要随意点击返回！！！！随意点击返回可能会导致消耗粉钻资源！！！！！！复刻活动剧情可能有意想不到的点击，如果卡住了就自己点掉重新开一次该任务吧[/b][/color]",
            "option": [
                "活动"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "分享",
            "entry": "分享任务链入口",
            "description": "必须在模拟器下载QQ，可以不登录但必须要有。默认重复分享直到分享奖励领完，也可设置最多分享次数。",
            "option": [
                "分享次数"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "一键领取",
            "entry": "一键领取任务链入口",
            "description": "一键领取活跃任务\n\n一键领取时尚任务\n\n一键领取时尚提升计划",
            "group": ["日常任务"]
        },
        {
            "name": "回忆小铺",
            "description": "识别当前回忆小铺六个商品；遇到金币商品或低折扣非排除钻石商品时暂停，否则自动换一批",
            "entry": "回忆小铺任务链入口",
            "option": [
                "回忆小铺自动购买金币商品",
                "回忆小铺钻石暂停折扣",
                "回忆小铺钻石暂停价格",
                "回忆小铺非免费继续刷新"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "心阶",
            "entry": "心阶任务链入口",
            "description": "只能起到基本的拿奖励的作用，打不了高分，想要高分自己搭配自己打一次",
            "group": ["周常任务"]
        },
        {
            "name": "联盟兑换幻之券",
            "entry": "联盟兑换幻之券任务链入口",
            "description": "可多选幻之券、绮之券，各自设置1～3张；库存或联盟币不足时按可买数量购买，并显示结果。",
            "option": [
                "联盟商店"
            ],
            "group": ["周常任务"]
        },
        {
            "name": "每周礼包",
            "entry": "每周礼包任务链入口",
            "description": "建议周常任务每周比如周日开一次就行了，不然拖慢每日进程",
            "group": ["周常任务"]
        }
    ],
    "option": {
        "机密任务执行方式": {
            "type": "select",
            "label": "机密任务执行方式",
            "description": "执行多次会直接批量完成；开始执行会先完整搭配和比拼一次，再批量完成剩余次数。",
            "default_case": "执行多次",
            "cases": [
                {
                    "name": "执行多次",
                    "pipeline_override": {
                        "联盟机密任务入口分流": {
                            "next": ["关闭机密任务周奖励弹窗", "点击前往当前目标", "机密任务已完成", "点击执行多次"]
                        }
                    }
                },
                {
                    "name": "开始执行",
                    "pipeline_override": {
                        "联盟机密任务入口分流": {
                            "next": ["关闭机密任务周奖励弹窗", "点击前往当前目标", "机密任务已完成", "点击开始执行", "点击执行多次"]
                        }
                    }
                }
            ]
        },
        "切换账号": {
            "type": "switch",
            "label": "切换账号",
            "description": "启动时按手机尾号切换已保存的官服账号。找不到账号或登录后15秒未返回开始页面时，start失败结束。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": ["登录账号尾号", "登录服务器"],
                    "pipeline_override": {
                        "启动账号记录初始化": {
                            "action": {"type": "Custom", "param": {"custom_action": "start_account_session", "custom_action_param": {"multi": true}}}
                        },
                        "启动闪暖": {"next": ["资源更新", "启动切换账号", "[JumpBack]嗯等"]},
                        "资源更新": {"next": ["启动切换账号", "[JumpBack]在资源更新页面", "[JumpBack]嗯等"]}
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "启动账号记录初始化": {
                            "action": {"type": "Custom", "param": {"custom_action": "start_account_session", "custom_action_param": {"multi": false}}}
                        },
                        "启动闪暖": {"next": ["资源更新", "点击开始", "[JumpBack]嗯等"]},
                        "资源更新": {"next": ["点击开始", "[JumpBack]在资源更新页面", "[JumpBack]嗯等"]}
                    }
                }
            ]
        },
        "登录服务器": {
            "type": "select",
            "label": "登录服务器",
            "description": "账号登录后切换服务器。只在全部服务器名称区域识别，目标名称任意一个字命中即点击。查找或返回开始页面超过15秒时，start失败结束。",
            "default_case": "保持当前服务器",
            "cases": [
                {
                    "name": "保持当前服务器",
                    "pipeline_override": {
                        "启动切换服务器": {
                            "action": {"type": "Custom", "param": {"custom_action": "switch_server", "custom_action_param": {"server": ""}}}
                        }
                    }
                },
                {
                    "name": "千羽森林",
                    "pipeline_override": {
                        "启动切换服务器": {
                            "action": {"type": "Custom", "param": {"custom_action": "switch_server", "custom_action_param": {"server": "千羽森林"}}}
                        }
                    }
                },
                {
                    "name": "抖落繁星",
                    "pipeline_override": {
                        "启动切换服务器": {
                            "action": {"type": "Custom", "param": {"custom_action": "switch_server", "custom_action_param": {"server": "抖落繁星"}}}
                        }
                    }
                },
                {
                    "name": "镜中圆舞",
                    "pipeline_override": {
                        "启动切换服务器": {
                            "action": {"type": "Custom", "param": {"custom_action": "switch_server", "custom_action_param": {"server": "镜中圆舞"}}}
                        }
                    }
                },
                {
                    "name": "童话香氛",
                    "pipeline_override": {
                        "启动切换服务器": {
                            "action": {"type": "Custom", "param": {"custom_action": "switch_server", "custom_action_param": {"server": "童话香氛"}}}
                        }
                    }
                }
            ]
        },
        "登录账号尾号": {
            "type": "input",
            "label": "手机尾号",
            "inputs": [
                {
                    "name": "suffix",
                    "label": "手机尾号",
                    "description": "填写已保存账号的手机号码后4位，保留开头的0。最多上滑查找10次。",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^[0-9]{4}$",
                    "pattern_msg": "请输入4位数字手机尾号"
                }
            ],
            "pipeline_override": {
                "启动切换账号": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "switch_account",
                            "custom_action_param": {"suffix": "{suffix}"}
                        }
                    }
                }
            }
        },
        "联盟商店": {
            "type": "checkbox",
            "label": "联盟商店",
            "description": "按幻之券、绮之券顺序购买；库存或联盟币不足时购买可买数量，并提示未买满原因。",
            "default_case": [
                "幻之券"
            ],
            "cases": [
                {
                    "name": "幻之券",
                    "option": [
                        "联盟商店幻之券购买数量"
                    ],
                    "pipeline_override": {
                        "联盟商店选择幻之券": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "绮之券",
                    "option": [
                        "联盟商店绮之券购买数量"
                    ],
                    "pipeline_override": {
                        "联盟商店选择绮之券": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "联盟商店幻之券购买数量": {
            "type": "input",
            "label": "幻之券购买数量",
            "inputs": [
                {
                    "name": "quantity",
                    "label": "购买张数",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^[1-3]$",
                    "pattern_msg": "请输入1～3之间的整数"
                }
            ],
            "pipeline_override": {
                "联盟商店选择幻之券": {
                    "repeat": "{quantity}"
                }
            }
        },
        "联盟商店绮之券购买数量": {
            "type": "input",
            "label": "绮之券购买数量",
            "inputs": [
                {
                    "name": "quantity",
                    "label": "购买张数",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^[1-3]$",
                    "pattern_msg": "请输入1～3之间的整数"
                }
            ],
            "pipeline_override": {
                "联盟商店选择绮之券": {
                    "repeat": "{quantity}"
                }
            }
        },
        "时光钟表铺模式": {
            "type": "select",
            "label": "时光钟表铺模式",
            "description": "选择本次时光钟表铺任务的执行方式。",
            "default_case": "快速组队（关卡04）",
            "cases": [
                {
                    "name": "快速组队（关卡04）",
                    "pipeline_override": {}
                },
                {
                    "name": "独自登场_循环",
                    "option": [
                        "时光钟表铺独自登场次数"
                    ],
                    "pipeline_override": {
                        "时光钟表铺任务链入口": {
                            "next": ["重置时光钟表铺独自登场次数", "[JumpBack]返回主页面"]
                        },
                        "点击时光钟表铺": {
                            "next": ["点击01"]
                        },
                        "点击01": {
                            "next": ["点击独自登场"]
                        }
                    }
                }
            ]
        },
        "时光钟表铺独自登场次数": {
            "type": "input",
            "label": "独自登场次数",
            "description": "只能在独自登场必定失败时使用。0表示默认执行3次；1-3表示总执行次数。独自登场后将等待失败结算，单场等待超过180秒时结束任务且不计入次数。",
            "inputs": [
                {
                    "name": "solo_runs",
                    "label": "独自登场次数",
                    "description": "请输入0-3之间的整数。0表示总共执行3次；1-3表示对应的总执行次数。单场等待失败结算超过180秒时结束任务且不计入次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-3]$",
                    "pattern_msg": "请输入0-3之间的整数"
                }
            ],
            "pipeline_override": {
                "检查时光钟表铺独自登场次数": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "time_clock_shop_counter",
                            "custom_action_param": {
                                "operation": "count",
                                "max_runs": "{solo_runs}"
                            }
                        }
                    }
                }
            }
        },
        "不落的帷幕模式": {
            "type": "select",
            "label": "不落的帷幕模式",
            "description": "选择本次不落的帷幕任务的执行方式。",
            "default_case": "快速组队（高难度·第八幕）",
            "cases": [
                {
                    "name": "快速组队（高难度·第八幕）",
                    "pipeline_override": {}
                },
                {
                    "name": "独自登场_循环（普通难度·第一幕）",
                    "option": [
                        "不落的帷幕独自登场次数"
                    ],
                    "pipeline_override": {
                        "不落的帷幕任务链入口": {
                            "next": ["重置不落的帷幕独自登场次数", "[JumpBack]返回主页面"]
                        },
                        "点击上演中": {
                            "next": ["点击普通难度"]
                        },
                        "点击第一幕": {
                            "next": ["点击不落的帷幕-独自登场"]
                        }
                    }
                }
            ]
        },
        "不落的帷幕独自登场次数": {
            "type": "input",
            "label": "独自登场次数",
            "description": "只能在独自登场必定失败时使用。0表示默认执行3次；1-3表示总执行次数。若未识别到失败结算页，将立即结束且不再循环。",
            "inputs": [
                {
                    "name": "solo_runs",
                    "label": "独自登场次数",
                    "description": "请输入0-3之间的整数。0表示总共执行3次；1-3表示对应的总执行次数。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-3]$",
                    "pattern_msg": "请输入0-3之间的整数"
                }
            ],
            "pipeline_override": {
                "检查不落的帷幕独自登场次数": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "unending_curtain_counter",
                            "custom_action_param": {
                                "operation": "count",
                                "max_runs": "{solo_runs}"
                            }
                        }
                    }
                }
            }
        },
        "分享次数": {
            "type": "input",
            "label": "分享次数",
