{
    "interface_version": 2,
    "name": "MaaShiningNikki",
    "description": "闪耀暖暖小助手",
    "contact": "",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 闪现吧暖暖!",
    "github": "https://github.com/7iko-07/MaaShiningNikki",
    "version": "0.0.3",
    "title": "闪现吧暖暖",
    "icon": "logo.ico",
    "mirrorchyan_multiplatform":false,
    "agent": {
        "child_exec": "python",
        "child_args": [
        "-u",
        "./agent/main.py"
        ]
    },
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "group": [
        {
            "name": "日常任务"
        },
        {
            "name": "周常任务"
        }
    ],
    "task": [
        {
            "name": "start",
            "entry": "启动闪暖",
            "description": "启动闪耀暖暖app，登录并进入游戏，游戏卡顿会导致持续时间较长。",
            "group": ["日常任务"]
        },
        {
            "name": "好友",
            "entry": "好友任务链入口",
            "description": "好友一键送心\n\n联盟一键送心\n\n体力一键领取",
            "group": ["日常任务"]
        },
        {
            "name": "联盟",
            "entry": "联盟任务链入口",
            "description": "机密任务执行五次\n\n联盟捐献金币五次\n\n联盟福利一键领取",
            "group": ["日常任务"]
        },
        {
            "name": "邮件",
            "entry": "邮件任务链入口",
            "description": "邮件奖励一键领取",
            "group": ["日常任务"]
        },
        {
            "name": "福利",
            "entry": "福利任务链入口",
            "description": "每日签到\n\n补签领取\n\n免费体力补给领取",
            "group": ["日常任务"]
        },
        {
            "name": "结伴",
            "entry": "体力任务链入口",
            "description": "时光钟表铺\n\n不落的帷幕\n\n印象旅航",
            "group": ["日常任务"]
        },
        {
            "name": "美甲",
            "description":  "雇佣免费店员\n\n提取心意币\n\n特约顾客\n\n美甲点赞",
            "entry": "美甲任务链入口",
            "option": [
                "美甲特约顾客任务"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "制作目标服装",
            "description":  "目前只获取制衣引导的衣服的时空回廊材料\n\n必须依次设定目标，会从前往后做，遇到空会停",
            "entry": "制作目标服装任务链入口",
            "group": ["日常任务"]
        },
        {
            "name": "情报屋-左一",
            "description":  "只获取左一情报",
            "entry": "情报屋任务链入口",
            "option": [
                "情报屋挑战次数"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "回家",
            "entry": "回家任务链入口",
            "option": [
                "自习室是否离开"
            ],
            "description": "采购三次番茄炒蛋\n\n采购五次金币小物\n\n自习室好感度获取",
            "group": ["日常任务"]
        },
        {
            "name": "竞技场",
            "entry": "竞技场任务链入口",
            "option": [
                "竞技场刷新次数",
                "竞技场是否搭配服装"
            ],
            "description": "会对比当前批次，从左到右进行，玩家战力大于对方则自动挑战",
            "group": ["日常任务"]
        },
        {
            "name": "搭配评选赛",
            "entry": "搭配评选赛任务链入口",
            "description": "搭配评选赛点赞",
            "group": ["日常任务"]
        },
        {
            "name": "一键领取",
            "entry": "一键领取任务链入口",
            "description": "一键领取活跃任务\n\n一键领取时尚任务\n\n一键领取时尚提升计划",
            "group": ["日常任务"]
        },
        {
            "name": "少女的咏唱剧情",
            "entry": "活动任务链入口",
            "default_check": false,
            "description": "##[color:red][b]默认关闭，使用时不要随意点击返回！！！！随意点击返回可能会导致消耗粉钻资源！！！！！！[/b][/color]",
            "option": [
                "活动"
            ],
            "group": ["日常任务"]
        },
        {
            "name": "回忆小铺",
            "description": "识别当前回忆小铺六个商品；遇到金币商品或低折扣非排除钻石商品时暂停，否则自动换一批",
            "entry": "回忆小铺任务链入口",
            "option": [
                "回忆小铺设置"
            ],
            "group": ["日常任务"]
        }
    ],
    "option": {
        "活动":{
            "type": "checkbox",
            "description": "",
            "default_case": ["挑战关卡"],
            "cases": [
                {
                    "name": "挑战关卡",
                    "pipeline_override": {
                        "点击挑战关卡":{
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "活动剧情",
                    "pipeline_override": {
                        "点击活动剧情名称":{
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "美甲特约顾客任务":{
            "type": "switch",
            "description": "开启时美甲任务必须也开启，完成特约顾客三个手指，\n\n###**如果三个手指加起来达不到完美就会死循环，建议有一定美甲积累再做**",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "点击我的店铺空白2": {
                            "next": ["查找周好评礼包", "点击返回美甲页面"]
                        }
                    }
                }
            ]
        },
        "竞技场刷新次数": {
            "type": "input",
            "label": "竞技场刷新设置",
            "description": "调整竞技场战力刷新的最大轮数。",
            "inputs": [
                {
                    "name": "max_rounds",
                    "label": "最大刷新轮数",
                    "description": "查找弱对手的最大轮数，每轮对比3个对手",
                    "default": "5",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$|^[1-9][0-9]$$",
                    "pattern_msg": "请输入1-99之间的整数"
                }
            ],
            "pipeline_override": {
                "竞技场战力对比": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "area_a": [171, 675, 316, 26],
                                "area_b": [
                                    [8, 1047, 227, 29],
                                    [248, 1042, 222, 38],
                                    [492, 1043, 217, 42]
                                ],
                                "refresh": [153, 1114, 89, 27],
                                "max_rounds": 5,
                                "剩余次数": [473, 1100, 202, 32],
                                "空白区域": [534, 114, 17, 10],
                                "blank_click_delay": 1.0
                            }
                        }
                    }
                }
            }
        },
        "竞技场是否搭配服装":{
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "点击竞技场空白":{
                            "next": ["竞技场战力对比", "[JumpBack]在加载页面", "[JumpBack]点击OK-竞技场"]
                        }
                    }
                }
            ]
        },
        "自习室是否离开":{
            "type": "select",
            "description": "今日是否永久离开，不想关自习室陪伴的暖妈一定要选只是暂时离开",
            "default_case": "只是暂时离开",
            "cases": [
                {
                    "name": "只是暂时离开",
                    "pipeline_override": {
                        "点击退出自习室": {
                            "next": ["点击只是暂时离开"]
                        }
                    }
                },
                {
                    "name": "结束今日行程"
                }
            ]
        },
        "回忆小铺设置": {
            "type": "input",
            "label": "回忆小铺设置",
            "description": "配置回忆小铺金币商品购买、钻石商品暂停折扣，以及非免费刷新时是否继续。",
            "inputs": [
                {
                    "name": "auto_buy_gold",
                    "label": "自动购买金币商品",
                    "description": "开启后发现金币商品会自动点击购买并确认；关闭时发现金币商品会暂停。",
                    "default": "false",
                    "pipeline_type": "bool",
                    "verify": "^(true|false)$",
                    "pattern_msg": "请输入 true 或 false"
                },
                {
                    "name": "diamond_discount_threshold",
                    "label": "钻石暂停折扣",
                    "description": "请输入1-9之间的整数，例如4表示4折及以下暂停。\n\n出现低于此折扣的钻石商品时不再刷新。\n\n输入1时不因折扣暂停。",
                    "default": "4",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$",
                    "pattern_msg": "请输入1-9之间的整数"
                },
                {
                    "name": "diamond_price_threshold",
                    "label": "钻石暂停价格",
                    "description": "不包括排除商品。存在实际价格低于该值的钻石商品时暂停，优先级高于折扣判断。\n\n输入0表示不按价格暂停。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入非负整数"
                },
                {
                    "name": "continue_refresh_when_not_free",
                    "label": "非免费继续刷新",
                    "description": "开启后“换一批”不是免费刷新时仍继续点击；关闭时会暂停。",
                    "default": "false",
                    "pipeline_type": "bool",
                    "verify": "^(true|false)$",
                    "pattern_msg": "请输入 true 或 false"
                }
            ],
            "pipeline_override": {
                "商城检查回忆小铺商品": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "auto_buy_gold": "{auto_buy_gold}",
                                "continue_refresh_when_not_free": "{continue_refresh_when_not_free}",
                                "diamond_discount_threshold": "{diamond_discount_threshold}",
                                "diamond_price_threshold": "{diamond_price_threshold}"
                            }
                        }
                    }
                }
            }
        },
        "情报屋挑战次数": {
            "type": "input",
            "label": "情报屋挑战次数",
            "description": "配置本次托管调查的挑战次数。输入0时按原逻辑根据体力挑战最大次数；初始次数为2次，输入2时不会点击加号。",
            "inputs": [
                {
                    "name": "challenge_times",
                    "label": "挑战次数",
                    "description": "请输入0或2-10之间的整数。0表示按体力自动挑战最大次数；情报屋默认初始为2次，每增加1次会点击一次加号。",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^(0|[2-9]|10)$",
                    "pattern_msg": "请输入0或2-10之间的整数"
                }
            ],
            "pipeline_override": {
                "情报屋自动托管调查": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "challenge_times": "{challenge_times}"
                            }
                        }
                    }
                }
            }
        }
    }
}
