    },
    "兑换码全选旧码": {
        "$comment": "Android Ctrl+A：先按修饰键，再按 A。随后删除选中文本。",
        "action": {"type": "Shell", "param": {"cmd": "input keycombination 113 29"}},
        "next": ["兑换码删除旧码"]
    },
