{
    "是否是主页面": {
        "recognition": {
            "type": "Or",
            "param":{
                "any_of": [
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": [
                                "活动.png"
                            ],
                            "roi": [3, 249, 133, 569]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": [
                                "心之门.png"
                            ],
                            "roi": [3, 249, 133, 569]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "活动_金色头像.png",
                            "roi": [3, 249, 133, 569]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": []
    },
    "玩家名片页面点击空白": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [254, 1119, 466, 50],
                "expected": ["玩家编号", "版本号"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [337, 86, 13, 7]
            }
        },
        "post_delay": 0,
        "next": ["是否是主页面"],
        "timeout": 15000,
        "rate_limit": 250
    },
    "主页点击esc":{
        "recognition": {
            "type": "And",
            "param":{
                "all_of": [
                    {"recognition": {
                        "type": "Or",
                        "param": {
                            "any_of": [
                                {"recognition": {
                                    "type": "TemplateMatch",
                                    "param": {
                                        "template": "主页音乐图标-关.png",
                                        "roi": [86, 0, 108, 173]
                                    }
                                }},
                                {"recognition": {
                                    "type": "TemplateMatch",
                                    "param": {
                                        "template": "主页音乐图标-开.png",
                                        "roi": [86, 0, 108, 173]
                                    }
                                }}
                            ]
                        }
                    }},
                    {"recognition": {
                        "type": "OCR",
                        "param": {
                            "roi": [490, 1000, 230, 80],
                            "expected": ["提示"]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": ["点击esc"]
    },
    "关闭退出游戏确认弹窗": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [104, 509, 517, 161],
                "expected": ["确定退出游戏吗[？?]?"]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "dismiss_exit_confirm"
            }
        }
    },
    "点击esc":{
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 111
            }
        }
    },
    "点击主页空白区域": {
        "recognition": {
            "type": "Or",
            "param":{
                "any_of": [
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-关.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-开.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [80, -50, 0, 0]
            }
        },
        "post_wait_freezes": 1000
    },
    "点击空白区域": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [267, 42, 228, 55]
            }
        }
    },
    "返回主页面": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
			"[JumpBack]关闭退出游戏确认弹窗",
			"[JumpBack]玩家名片页面点击空白",
			"是否是主页面",
			"[JumpBack]点击返回",
            "[JumpBack]点击体力用尽确定",
            "[JumpBack]主页点击esc",
            "[JumpBack]点击OK-竞技场",
            "[JumpBack]在加载页面",
            "[JumpBack]在接受投稿页面",
            "[JumpBack]导航在空白页面",
            "[JumpBack]点击esc"
		]
    }
}
