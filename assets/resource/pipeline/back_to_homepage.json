{
    "是否是主页面": {
        "recognition": {
            "type": "Or",
            "param":{
                "any_of": [
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": [
                                "活动.png"
                            ],
                            "roi": [3, 249, 133, 569]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": [
                                "心之门.png"
                            ],
                            "roi": [3, 249, 133, 569]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": []
    },
    "玩家名片页面点击esc": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {"recognition": {
                        "type": "OCR",
                        "param": {
                            "roi": [0, 1180, 720, 100],
                            "expected": ["道具", "复制编号"]
                        }
                    }},
                    {"recognition": {
                        "type": "OCR",
                        "param": {
                            "roi": [254, 1119, 466, 50],
                            "expected": ["玩家编号", "版本号"]
                        }
                    }}
                ]
            }
        },
        "action": "DoNothing",
        "next": ["点击esc"]
    },
    "主页点击esc":{
        "recognition": {
            "type": "Or",
            "param":{
                "any_of": [
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-关.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-开.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": ["点击esc"]
    },
    "点击esc":{
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 111
            }
        }
    },
    "点击主页空白区域": {
        "recognition": {
            "type": "Or",
            "param":{
                "any_of": [
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-关.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }},
                    {"recognition": {
                        "type": "TemplateMatch",
                        "param": {
                            "template": "主页音乐图标-开.png",
                            "roi": [86, 0, 108, 173]
                        }
                    }}
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [80, -50, 0, 0]
            }
        },
        "post_wait_freezes": 1000
    },
    "点击空白区域": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [267, 42, 228, 55]
            }
        }
    },
    "返回主页面": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
			"[JumpBack]玩家名片页面点击esc",
			"是否是主页面",
			"[JumpBack]点击返回",
            "[JumpBack]点击体力用尽确定",
            "[JumpBack]主页点击esc",
            "[JumpBack]点击OK-竞技场",
            "[JumpBack]在加载页面",
            "[JumpBack]在接受投稿页面",
            "[JumpBack]导航在空白页面",
            "[JumpBack]点击esc"
		]
    }
}
