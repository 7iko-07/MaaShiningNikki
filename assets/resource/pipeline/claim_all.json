{
    "一键领取任务链入口": {
		"next": ["一键领取任务链准备"],
		"timeout": 2000
    },
	"一键领取任务链准备": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "page_navigate",
                "custom_action_param": {
                    "target": "任务"
                }
            }
        },
        "next": ["点击一键领取"],
        "timeout": 30000
    },
	"点击一键领取": {
        "recognition": {
			"type": "OCR",
			"param": {
				"roi":[234, 1199, 268, 81],
				"expected": ["键领取","领取","键"]
			}
		},
		"action": {
			"type": "Click",
			"param": {}
		},
        "repeat": 2,
        "repeat_delay": 2000,
		"post_delay": 2000,
		"next": ["点击今日活跃","点击时尚任务"],
		"timeout": 2000
    },
    "点击今日活跃":{
        "recognition": {
			"type": "TemplateMatch",
