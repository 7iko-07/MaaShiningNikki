{
    "点击返回": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "back1.png",
                "roi": [0, 0, 379, 404]
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "timeout": 5000,
        "post_wait_freezes": 1000
    },
    "点击菜单": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [670, 144]
            }
        },
        "timeout": 1000
    },
    "下划菜单": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [670, 144],
                "begin_offset": [0, 150, 0, 0],
                "end_offset": [0, 650, 0, 0]
            }
        },
        "timeout": 1000
    },
    "点击菜单并下划": {
		"recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [670, 144]
            }
        },
        "timeout": 1000,
		"next": ["下划菜单"]
	},
    "点击底部菜单并左划": {
		"recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [700, 1150]
            }
        },
        "timeout": 1000,
		"next": ["左划底部菜单"]
	},
    "左划底部菜单": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [700, 1150],
                "begin_offset": [-100, 0, 0, 0],
                "end_offset": [-600, 0, 0, 0]
            }
        },
        "timeout": 1000
    },
    "点击底部菜单并右划": {
		"recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [700, 1150]
            }
        },
        "timeout": 1000,
		"next": ["右划底部菜单"]
	},
    "右划底部菜单": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [98, 1145],
                "end_offset": [600, 0, 0, 0]
            }
        },
        "timeout": 1000
    },
    "stop": {
		"action": "StopTask"
	},
    "点击叉号": {
        "recognition": {
            "type": "FeatureMatch",
            "param": {
                "template": "close_news.png",
                "green_mask": true
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "timeout": 5000
    },
    "上划活动条": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [54, 604],
                "end": [58, 285,0,0]
            }
        },
        "timeout": 1000
    },
    "在加载页面":{
		"recognition": {
			"type": "ColorMatch",
			"param":{
				"roi": [27, 1183, 10, 7],
				"upper": [255, 216, 164],
				"lower": [254, 200, 129],
				"count": 10
			}
		},
		"action": "DoNothing",
		"post_delay": 1000
	},
    "在接受投稿页面":{
		"recognition": {
			"type": "OCR",
			"param": {
				"roi": [230, 590, 259, 113],
				"expected": ["正在接收投稿", "正在", "接收", "投稿"]
			}
		},
		"action": "DoNothing",
		"post_delay": 1000
	}
}