    "点击活动剧情": {
        "recognition": {
			"type": "DirectHit",
			"param": {}
		},
		"action": {
			"type": "Custom",
			"param": {
				"custom_action": "click_region",
				"custom_action_param": {
					"step": 40,
					"delay": 50,
					"random": true,
					"roi": [0, 0, 720, 1280],
					"max_points": 20000,
					"change_detection": true,
					"exclude": [[0, 14, 120, 114], [543, 0, 177, 202],[440, 1073, 280, 112]],
					"stop_on_no_change": true
				}
			}
		},
		"post_wait_freezes": 500,
		"next": ["在活动剧情页面"],
		"timeout": 2000,
        "anchor": "点击活动剧情"
    },
	"在活动剧情页面": {
		"recognition": "DirectHit",
		"action": {
			"type": "DoNothing",
			"param": {}
		},
		"post_wait_freezes": 500,
		"next": ["识别剧情过完了并停止任务", "[JumpBack]点击聊天框", "[JumpBack]点击剧情叉号","[Anchor]点击活动剧情"],
		"timeout": 2000
    },
    "点击聊天框":{
        "recognition": {
			"type": "Or",
			"param": {
				"any_of": [
					{
						"recognition":{
							"type": "OCR",
							"param": {
								"roi": [538, 0, 182, 277],
								"expected": ["自动播放","自动","播放","文字速度","文字","速度"]
							}
						}
					},
					{
						"recognition":{
							"type": "ColorMatch",
							"param": {
								"roi": [538, 0, 182, 277],
								"lower": [0, 0, 0],
								"upper": [0, 0, 0],
								"count": 3000,
								"connected": true
							}
						}
					}
				]
			}
		},
		"action": {
			"type": "Click",
			"param": {
				"target": [0, 301, 720, 804]
			}
		},
        "post_delay": 100,
		"timeout": 2000
    },
	"点击剧情叉号":{
		"recognition": {
            "type": "FeatureMatch",
            "param": {
