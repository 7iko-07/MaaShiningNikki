{
    "活动任务链入口": {
		"next": ["活动任务链准备", "[JumpBack]返回主页面"],
		"timeout": 2000
    },
	"活动任务链准备": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "page_navigate",
                "custom_action_param": {
                    "target": "主页面"
                }
            }
        },
        "next": ["点击活动名称","[JumpBack]上划活动条"],
        "timeout": 30000
    },
    "点击活动名称": {
        "recognition": {
			"type": "OCR",
			"param": {
				"roi": [0, 190, 129, 61],
				"expected": ["少女的咏唱"]
			}
		},
		"action": {
			"type": "Custom",
            "param": {
                "custom_action": "click_and_wait_change",
                "custom_action_param":{}
            }
		},
		"post_wait_freezes": 30000,
		"next": ["点击活动页面-空白"],
		"timeout": 2000
    },
	"点击活动页面-空白":{
		"recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [594, 25, 21, 14]
            }
		},
		"repeat": 2,
		"repeat_delay": 500,
		"next": ["点击活动剧情名称"]
	},
	"点击活动剧情名称": {
        "recognition": {
			"type": "OCR",
			"param": {
				"expected": ["演出","舞台"],
				"roi": [512, 912, 208, 134]
			}
		},
		"action": {
			"type": "Custom",
            "param": {
                "custom_action": "click_and_wait_change",
                "custom_action_param":{}
            }
		},
		"post_wait_freezes": 500,
		"next": ["点击活动剧情"],
		"timeout": 2000
    },
    "点击活动剧情": {
        "recognition": {
			"type": "DirectHit",
			"param": {}
		},
		"action": {
			"type": "Custom",
			"param": {
				"custom_action": "click_region",
				"custom_action_param": {
					"step": 40,
					"delay": 50,
					"random": true,
					"roi": [0, 0, 720, 1280],
					"max_points": 20000,
					"change_detection": true,
					"exclude": [[0, 14, 120, 114], [543, 0, 177, 202],[440, 1073, 280, 112]],
					"stop_on_no_change": true
				}
			}
		},
		"post_wait_freezes": 500,
		"next": ["在活动剧情页面"],
		"timeout": 2000,
        "anchor": "点击活动剧情"
    },
	"在活动剧情页面": {
		"recognition": "DirectHit",
		"action": {
			"type": "DoNothing",
			"param": {}
		},
		"post_wait_freezes": 500,
		"next": ["识别剧情过完了并停止任务", "[JumpBack]点击聊天框", "[JumpBack]点击剧情叉号","[Anchor]点击活动剧情"],
		"timeout": 2000
    },
    "点击聊天框":{
        "recognition": {
			"type": "Or",
			"param": {
				"any_of": [
					{
						"recognition":{
							"type": "OCR",
							"param": {
								"roi": [538, 0, 182, 277],
								"expected": ["自动播放","自动","播放","文字速度","文字","速度"]
							}
						}
					},
					{
						"recognition":{
							"type": "ColorMatch",
							"param": {
								"roi": [538, 0, 182, 277],
								"lower": [0, 0, 0],
								"upper": [0, 0, 0],
								"count": 3000,
								"connected": true
							}
						}
					}
				]
			}
		},
		"action": {
			"type": "Click",
			"param": {
				"target": [0, 301, 720, 804]
			}
		},
        "post_delay": 100,
		"timeout": 2000
    },
	"点击剧情叉号":{
		"recognition": {
            "type": "FeatureMatch",
            "param": {
                "template": "剧情叉号.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
		"repeat": 3,
        "timeout": 5000
	},
	"识别剧情过完了并停止任务":{
		"recognition": {
			"type": "OCR",
			"param":{
				"roi": [552, 33, 168, 91],
				"expected": ["跳过"]
			}
		},
		"focus": {
			"Node.Action.Starting": "#[color:blue][b]剧情过完了[/b][/color]"
		},
		"next": ["stop"]
	}
}
