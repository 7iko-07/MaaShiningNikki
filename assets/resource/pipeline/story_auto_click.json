{
    "剧情自动点击任务链入口": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "story_auto_click",
                "custom_action_param": {
                    "search_chapters": false
                }
            }
        },
        "focus": {
            "Node.Action.Starting": "剧情自动点击：遇到特殊互动将停止。",
            "Node.Action.Succeeded": {
                "content": "[size:14][color:#A16207][b]剧情点击结束，需要手动操作。[/b][/color][/size]",
                "display": "log"
            },
            "Node.Action.Failed": "[color:red]剧情点击执行异常，请检查设备连接及运行日志。[/color]"
        },
        "next": []
    },
    "剧情自动点击控制器异常": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "story_auto_click_controller_failed"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "story_auto_click_controller_guard"
            }
        },
        "next": []
    },
    "剧情自动点击特殊互动识别": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0, 200, 720, 1080],
                "expected": [
                    "请选择",
                    "选择.{0,6}(回答|选项|答案)",
                    "开始推演真相",
                    "求助暖暖",
                    "听暖暖的",
                    "推理真相",
                    "提交答案",
                    "开始答题",
                    "确认答案",
                    "推荐搭配",
                    "开始挑战",
                    "确认购买",
                    "确认兑换",
                    "是否消耗"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "story_auto_click_manual_stop"
            }
        },
        "next": []
    },
    "剧情自动点击查找章节": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_region",
                "custom_action_param": {
                    "step": 70,
                    "delay": 50,
                    "roi": [0, 0, 720, 1280],
                    "max_points": 20000,
                    "change_detection": true,
                    "exclude": [
                        [0, 14, 120, 114],
                        [543, 0, 177, 202],
                        [0, 1156, 155, 89]
                    ],
                    "stop_on_no_change": true,
                    "direction": "left_to_right"
                }
            }
        },
        "next": ["剧情自动点击调度"],
        "timeout": 2000,
        "anchor": "剧情自动点击查找章节"
    },
    "剧情自动点击调度": {
        "recognition": "DirectHit",
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "剧情自动点击控制器异常",
            "剧情自动点击结束识别",
            "剧情自动点击特殊互动识别",
            "[JumpBack]剧情自动点击推进对话",
            "[Anchor]剧情自动点击查找章节"
        ],
        "timeout": 2000
    },
    "剧情自动点击推进对话": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [538, 0, 182, 277],
                                "expected": ["自动播放", "自动", "播放", "文字速度", "文字", "速度"]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [538, 0, 182, 277],
                                "lower": [0, 0, 0],
                                "upper": [0, 0, 0],
                                "count": 3000,
                                "connected": true
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_region",
                "custom_action_param": {
                    "step": 70,
                    "delay": 50,
                    "roi": [0, 301, 720, 804],
                    "max_points": 20000,
                    "change_detection": true,
                    "stop_on_no_change": true,
                    "direction": "left_to_right"
                }
            }
        },
        "timeout": 2000
    },
    "剧情自动点击结束识别": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [552, 33, 168, 91],
                "expected": ["跳过"]
            }
        },
        "focus": {
            "Node.Action.Starting": "#[color:blue][b]剧情已结束[/b][/color]"
        },
        "next": ["stop"]
    }
}
