{
    "笼中歌任务链入口": {
        "next": [
            "笼中歌任务链准备",
            "[JumpBack]返回主页面"
        ],
        "timeout": 2000
    },
    "笼中歌任务链准备": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "page_navigate",
                "custom_action_param": {
                    "target": "主页面"
                }
            }
        },
        "next": [
            "点击笼中歌名称",
            "[JumpBack]上划活动条"
        ],
        "timeout": 30000
    },
    "点击笼中歌名称": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [3, 122, 112, 695],
                                "expected": ["笼中?歌"]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [3, 122, 112, 695],
                                "template": "笼中歌.png"
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_and_wait_change",
                "custom_action_param": {
                    "max_retries": 1,
                    "timeout": 30000,
                    "fail_on_timeout": true
                }
            }
        },
        "next": ["关闭笼中歌签到"]
    },
    "关闭笼中歌签到": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_and_wait_change",
                "custom_action_param": {
                    "target": [333, 133, 20, 18],
                    "popup_node": "笼中歌签到弹窗",
                    "ready_nodes": ["点击笼中歌剧情入口"]
                }
            }
        },
        "next": ["点击笼中歌剧情入口"],
        "timeout": 30000
    },
    "笼中歌签到弹窗": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [40, 100, 640, 400],
                "expected": ["活动签到"]
            }
        }
    },
    "点击笼中歌剧情入口": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [0, 889, 230, 178],
                                "expected": ["巡旅", "新生北地"]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [0, 889, 230, 178],
                                "template": "笼中歌_巡旅.png"
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_and_wait_change",
                "custom_action_param": {
                    "max_retries": 1,
                    "timeout": 30000,
                    "fail_on_timeout": true
                }
            }
        },
        "post_wait_freezes": 500,
        "next": ["剧情自动点击任务链入口"]
    }
}
