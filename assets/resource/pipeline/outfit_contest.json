{
    "搭配评选赛任务链入口": {
        "action": {
            "type": "Custom",
            "param": {"custom_action": "outfit_contest_guard"}
        },
        "attach": {"auto_submit": false},
        "next": ["搭配评选赛任务链准备"],
        "timeout": 2000
    },
    "搭配评选赛任务链准备": {
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "page_navigate",
                "custom_action_param": {
                    "target": "搭配评选赛",
                    "wait_timeout": 30
                }
            }
        },
        "next": ["点击我当评委"],
        "timeout": 30000
    },
    "点击我当评委": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["我当评委", "当评", "评委"],
                "roi": [346, 1092, 374, 188]
            }
        },
        "action": {
            "type": "Custom",
            "param": {"custom_action": "click_center"}
        },
        "post_delay": 250,
        "next": ["点赞搭配评选赛"],
        "timeout": 30000,
        "rate_limit": 250
    },
    "点赞搭配评选赛": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [532, 1075, 20, 20],
                                "method": 4,
                                "lower": [215, 175, 115],
                                "upper": [255, 220, 185],
                                "count": 300
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["赞"],
                                "roi": [490, 1115, 115, 55]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [540, 1140]
            }
        },
        "post_delay": 250,
        "next": ["搭配评选赛关闭奖励"],
        "timeout": 30000,
        "rate_limit": 250
    },
