                "target": [540, 1140]
            }
        },
        "post_delay": 250,
        "next": ["点赞搭配评选赛", "搭配评选赛评委结束"],
        "timeout": 30000,
        "rate_limit": 250
    },
    "搭配评选赛评委结束": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
